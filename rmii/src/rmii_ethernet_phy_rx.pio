; Oversampled receive: from the moment carrier appears, sample RXD0/RXD1 once
; per REF_CLK cycle and let software recover the dibits.
;
; At 10 Mbps the PHY repeats each dibit about ten times, but measurement on this
; board showed runs of 9 cycles as well as 10, so any fixed cadence sampler
; eventually slips a dibit and every frame then fails its CRC. Run length
; decoding in software tolerates that, at the cost of 16 bits of capture per
; dibit.
.program rmii_ethernet_phy_rx_data
    wait 0 pin 2        ; idle
    wait 1 pin 2        ; carrier detected, capture from here
.wrap_target
    in pins, 2
.wrap

% c-sdk {

static inline void rmii_ethernet_phy_rx_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 3, false);

    pio_sm_config c = rmii_ethernet_phy_rx_data_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin);

    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin + 1);
    pio_gpio_init(pio, pin + 2);

    // 16 samples per 32 bit push, one dma transfer per 16 cycles
    sm_config_set_in_shift(&c, true, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    sm_config_set_clkdiv(&c, 1);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
